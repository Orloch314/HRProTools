@using System.Text.Json
@inject ReferenceAdministrationService Administration
@if(message.Length > 0){<div class="notice @(error ? "notice-error" : "notice-success")">@message</div>}
<section class="panel"><div class="panel-title"><h2>@(Editable ? "Categorías publicadas" : "Permisos vigentes")</h2>@if(Editable){<button class="btn-primary" @onclick="New">Nuevo permiso</button>}</div>
<div class="form-grid"><label><span>Buscar</span><input @bind="search" @bind:event="oninput"/></label>@if(Editable){<label><span>Estado de última versión</span><select @bind="state"><option value="">Todos</option><option value="ACTIVE">Activo</option><option value="INACTIVE">Inactivo</option></select></label>}</div>
<div class="table-wrap"><table><thead><tr><th>Permiso</th><th>Fundamento</th><th>Vigencia / estado</th><th></th></tr></thead><tbody>
@foreach(var version in Visible){var rule = Read(version);<tr><td>@rule.Name<small>@rule.Code · versión @version.Revision</small></td><td>@rule.Law · @rule.Article</td><td>@version.ValidFrom.ToString("dd/MM/yyyy") – @(version.ValidTo?.ToString("dd/MM/yyyy") ?? "Sin fin")<small>@(version.IsActive ? "Activo" : "Inactivo")</small></td><td><button id="@($"legal-ficha-{version.Id:N}")" class="link-button" @onclick="() => detail=version">Ficha</button>@if(Editable){<button class="link-button" @onclick="() => Edit(version)">Editar</button><button class="link-button" @onclick="() => Toggle(version)">@(version.IsActive ? "Desactivar" : "Activar")</button><button class="link-button" @onclick="() => history=version.Code">Historial</button>}</td></tr>}
</tbody></table></div></section>
@if(detail is not null){<LegalPermissionDialog @key="detail.Id" Rule="@Read(detail)" Version="@detail.Revision" TriggerId="@($"legal-ficha-{detail.Id:N}")" Closed="@(() => detail=null)"/>}
@if(history is not null && Editable){<section class="panel"><div class="panel-title"><h2>Historial · @history</h2><button class="link-button" @onclick="() => history=null">Cerrar</button></div>@foreach(var version in versions.Where(x=>x.Code==history).OrderByDescending(x=>x.Revision)){<details><summary>Versión @version.Revision · @version.ValidFrom.ToString("dd/MM/yyyy") – @(version.ValidTo?.ToString("dd/MM/yyyy") ?? "Sin fin") · @(version.IsActive ? "Activa" : "Inactiva")</summary><p>@version.ChangeReason · @version.ChangedAtUtc.ToString("u") · Actor: @version.ChangedByUserId</p><LegalRuleDetails Rule="@Read(version)"/></details>}</section>}
@if(editing && Editable){<section class="panel editor-accent"><div class="panel-title"><h2>@(expected.HasValue ? "Publicar nueva versión" : "Nuevo permiso parametrizable")</h2><button class="link-button" @onclick="() => editing=false">Cancelar</button></div>
<div class="notice">Los cambios rigen para nuevas presentaciones desde la vigencia indicada. Las solicitudes existentes conservan regla, documentos, decisiones y consumo. Las condiciones documentales y de elegibilidad requieren revisión HR.</div>
<div class="form-grid">
@if(!expected.HasValue){<label><span>Código único</span><input @bind="form.Code" maxlength="64"/></label>}else{<p>Código: <strong>@form.Code</strong></p>}
<label><span>Nombre</span><input @bind="form.Name" maxlength="200"/></label><label><span>Grupo</span><input @bind="form.Group"/></label><label class="span-full"><span>Descripción</span><textarea @bind="form.Description" maxlength="4000"></textarea></label>
<label><span>Ley</span><input @bind="form.Law"/></label><label><span>Artículo</span><input @bind="form.Article"/></label><label><span>Fuente normativa (HTTPS)</span><input type="url" @bind="form.Source" maxlength="1500"/></label><label><span>Vigencia desde (presentación)</span><InputDate @bind-Value="form.From"/></label><label><span>Vigencia hasta (opcional)</span><InputDate @bind-Value="form.To"/></label>
@if(form.Previous?.Engine == "SPECIAL"){
 <div class="notice span-full">Regla especializada: @form.Duration (@form.Unit). La duración, unidad, naturaleza, remuneración calculable y límites requieren adaptar y probar su lógica. Este panel permite modificar los datos descriptivos, fuentes y estado; no simula reglas no soportadas.</div>
}else{
 @if(expected.HasValue){<p>Unidad: <strong>@form.Unit</strong>. Cambiarla requiere una categoría nueva para conservar los consumos.</p>}else{<label><span>Unidad</span><select @bind="form.Unit"><option value="DAYS">Días laborables</option><option value="HOURS">Horas laborables</option><option value="MINUTES">Minutos laborables</option><option value="WEEKS">Semanas consecutivas</option><option value="DAYS_OR_HOURS">Días u horas (límites en fracciones de jornada)</option></select></label>}
 <label><span>Duración legal (descripción)</span><input @bind="form.Duration"/></label><label><span>Máximo por solicitud (obligatorio en categorías nuevas)</span><InputNumber @bind-Value="form.Maximum"/></label><label><span>Límite por evento (opcional)</span><InputNumber @bind-Value="form.Event"/></label><label><span>Límite mensual (opcional)</span><InputNumber @bind-Value="form.Month"/></label><label><span>Límite anual (opcional)</span><InputNumber @bind-Value="form.Annual"/></label>
 <label><span>Naturaleza</span><select @bind="form.Protected"><option value="true">Obligatoria · revisión HR</option><option value="false">Discrecional</option></select></label><label><span>Goce</span><select @bind="form.Paid"><option value="true">Con goce</option><option value="false">Sin goce</option></select></label>
}
<label><span>Beneficiarios</span><input @bind="form.Beneficiaries"/></label><label><span>Condiciones de elegibilidad</span><textarea @bind="form.Requirements"></textarea></label><label><span>Documentación requerida</span><textarea @bind="form.Documentation"></textarea></label><label><span>Preaviso</span><input @bind="form.Notice"/></label><label><span>Régimen de remuneración (descripción)</span><textarea @bind="form.Remuneration"></textarea></label><label><span>Estado desde la vigencia</span><select @bind="form.Active"><option value="true">Activo</option><option value="false">Inactivo</option></select></label><label class="span-full"><span>Motivo de esta versión</span><textarea @bind="form.Reason" maxlength="1000"></textarea></label>
</div><button class="btn-primary" disabled="busy" @onclick="SaveAsync">Publicar versión</button></section>}
@code {
 [Parameter] public bool Editable {get;set;}
 private List<LegalPermissionVersion> versions=[]; private string search="",state="",message="";private bool error,editing,busy;private Guid? expected;private LegalPermissionAdminForm form=new();private LegalPermissionVersion? detail;private string? history;
 private static LegalPermissionType Read(LegalPermissionVersion v)=>JsonSerializer.Deserialize<LegalPermissionType>(v.RuleJson)!;
 private IEnumerable<LegalPermissionVersion> Visible => versions.Where(x=>Editable || x.ValidFrom<=GlobalReferenceQueries.Today).GroupBy(x=>x.Code).Select(g=>g.OrderByDescending(x=>x.ValidFrom).ThenByDescending(x=>x.Revision).First()).Where(x=>(Editable || (x.IsActive && (!x.ValidTo.HasValue || x.ValidTo>=GlobalReferenceQueries.Today))) && (state.Length==0 || x.IsActive==(state=="ACTIVE")) && (x.Code.Contains(search,StringComparison.OrdinalIgnoreCase)||Read(x).Name.Contains(search,StringComparison.OrdinalIgnoreCase)));
 protected override async Task OnInitializedAsync()=>await LoadAsync();
 private async Task LoadAsync(){versions=await Administration.GetPermissionsAsync();}
 private void New(){form=new();expected=null;editing=true;}
 private void Edit(LegalPermissionVersion version){form=LegalPermissionAdminForm.FromRule(Read(version),version.IsActive,version.ValidFrom>GlobalReferenceQueries.Today ? version.ValidFrom : GlobalReferenceQueries.Today);expected=version.Id;editing=true;}
 private void Toggle(LegalPermissionVersion version){Edit(version);form.Active=!version.IsActive;}
 private async Task SaveAsync(){if(busy)return;busy=true;try{await Administration.SavePermissionAsync(form.Rule(),form.From,form.To,form.Active,form.Reason,expected);editing=false;detail=null;await LoadAsync();message="Versión publicada. Se conservaron las solicitudes y versiones anteriores.";error=false;}catch(Exception ex){message=ex.Message;error=true;}finally{busy=false;}}
}
