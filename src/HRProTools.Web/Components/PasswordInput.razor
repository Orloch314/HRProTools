@using System.Linq.Expressions

<div class="password-input">
    <InputText id="@Id"
               type="password"
               Value="@Value"
               ValueChanged="@HandleValueChanged"
               ValueExpression="@ValueExpression"
               class="@CssClass"
               autocomplete="@Autocomplete"
               aria-required="@AriaRequired"
               placeholder="@Placeholder" />
    <button type="button"
            class="password-toggle"
            data-password-toggle
            data-password-target="@Id"
            aria-label="Mostrar contraseña"
            title="Mostrar contraseña">
        <svg data-password-show viewBox="0 0 24 24" aria-hidden="true">
            <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Zm10 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z" />
        </svg>
        <svg data-password-hide viewBox="0 0 24 24" aria-hidden="true" hidden>
            <path d="m3.3 2 18.7 18.7-1.3 1.3-3.2-3.2A11.7 11.7 0 0 1 12 20C5.5 20 2 14 2 14a17.6 17.6 0 0 1 3.6-4.3L2 6.1 3.3 2Zm4.4 9.8A3.5 3.5 0 0 0 12 16.2c.8 0 1.5-.2 2.1-.7l-1.5-1.5a1.6 1.6 0 0 1-2.1-2.1l-1.4-1.4c-.6.3-1 .8-1.4 1.3ZM12 8c6.5 0 10 6 10 6a17 17 0 0 1-2.3 3.1l-2.1-2.1c.2-.5.4-1.1.4-1.8A6 6 0 0 0 10.8 7L9 5.2c1-.2 2-.2 3-.2Z" />
        </svg>
    </button>
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter, EditorRequired] public Expression<Func<string>> ValueExpression { get; set; } = default!;
    [Parameter] public string CssClass { get; set; } = string.Empty;
    [Parameter] public string Autocomplete { get; set; } = "current-password";
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public string AriaRequired { get; set; } = "true";

    private async Task HandleValueChanged(string value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }
}
