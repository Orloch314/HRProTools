@page "/tenant/vacaciones/solicitudes"
@attribute [Authorize(Policy = AppPolicies.EmployeeRecords)]
@inject VacationRequestService Requests

<PageTitle>Solicitudes de vacaciones - HR ProTools</PageTitle>

<div class="page-heading">
    <div>
        <span class="eyebrow">Fase 4</span>
        <h1>Solicitudes de vacaciones</h1>
        <p>La aprobación consume las reservas originales; el rechazo las libera.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="notice @(hasError ? "notice-error" : "notice-success")">@message</div>
}

@if (selected is not null)
{
    <section class="panel editor-accent">
        <div class="panel-title"><h2>Resolver solicitud</h2><button class="btn-secondary" @onclick="() => selected = null">Cerrar</button></div>
        <div class="detail-grid">
            <div><span>Funcionario</span><strong>@selected.EmployeeNumber · @selected.EmployeeName</strong></div>
            <div><span>Empresa</span><strong>@selected.Company</strong></div>
            <div><span>Intervalo</span><strong>@selected.StartDate.ToString("dd/MM/yyyy") – @selected.EndDate.ToString("dd/MM/yyyy")</strong></div>
            <div><span>Días reservados</span><strong>@selected.RequestedDays</strong></div>
        </div>
        <label><span>Comentario de decisión</span><textarea @bind="comment"></textarea></label>
        <div><button class="btn-primary" @onclick="ApproveAsync">Aprobar</button> <button class="btn-danger" @onclick="RejectAsync">Rechazar</button></div>
    </section>
}

<section class="panel">
    <div class="panel-title"><h2>Pendientes</h2><span>@items.Count</span></div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Funcionario</th><th>Empresa</th><th>Intervalo</th><th>Días</th><th>Registrada</th><th></th></tr></thead>
            <tbody>
            @if (items.Count == 0)
            {
                <tr><td colspan="6" class="empty">No hay solicitudes pendientes.</td></tr>
            }
            @foreach (var item in items)
            {
                <tr><td>@item.EmployeeNumber<small>@item.EmployeeName</small></td><td>@item.Company</td><td>@item.StartDate.ToString("dd/MM/yyyy") – @item.EndDate.ToString("dd/MM/yyyy")</td><td>@item.RequestedDays</td><td>@item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td><button class="link-button" @onclick="() => Select(item)">Resolver</button></td></tr>
            }
            </tbody>
        </table>
    </div>
</section>

@code {
    private List<VacationDecisionItem> items = [];
    private VacationDecisionItem? selected;
    private string comment = string.Empty;
    private string message = string.Empty;
    private bool hasError;

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() => items = await Requests.GetPendingForDecisionAsync();
    private void Select(VacationDecisionItem item) { selected = item; comment = string.Empty; }

    private async Task ApproveAsync() => await ResolveAsync(
        () => Requests.ApproveAsync(selected!.Id, comment),
        "Solicitud aprobada y reserva convertida en consumo definitivo.");

    private async Task RejectAsync() => await ResolveAsync(
        () => Requests.RejectAsync(selected!.Id, comment),
        "Solicitud rechazada y reserva liberada.");

    private async Task ResolveAsync(Func<Task> action, string success)
    {
        try
        {
            await action();
            selected = null;
            await LoadAsync();
            hasError = false;
            message = success;
        }
        catch (Exception ex)
        {
            hasError = true;
            message = ex.Message;
        }
    }
}
