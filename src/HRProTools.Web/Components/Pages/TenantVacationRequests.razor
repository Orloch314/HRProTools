@page "/tenant/solicitudes"
@page "/tenant/vacaciones/solicitudes"
@attribute [Authorize(Policy = AppPolicies.VacationWorkflowAccess)]
@inject VacationRequestService VacationRequests
@inject PermissionRequestService PermissionRequests

<PageTitle>Solicitudes - HR ProTools</PageTitle>

<div class="page-heading">
    <div><span class="eyebrow">Fase 4</span><h1>Solicitudes</h1><p>Circuito compartido de vacaciones y permisos. Los permisos no afectan el saldo de vacaciones.</p></div>
    <AuthorizeView Roles="@AppRoles.TenantAdministrator"><Authorized><a class="btn-secondary" href="tenant/vacaciones/circuito">Configurar circuito</a></Authorized></AuthorizeView>
</div>

<div class="tab-list">
    <button class="tab-button @(activeType == "vacations" ? "active" : string.Empty)" @onclick='() => ChangeType("vacations")'>Vacaciones</button>
    <button class="tab-button @(activeType == "permissions" ? "active" : string.Empty)" @onclick='() => ChangeType("permissions")'>Permisos</button>
</div>

@if (!string.IsNullOrWhiteSpace(message)) { <div class="notice @(hasError ? "notice-error" : "notice-success")">@message</div> }

@if (activeType == "vacations")
{
    @if (selectedVacation is not null)
    {
        <section class="panel editor-accent">
            <div class="panel-title"><h2>Detalle del circuito de vacaciones</h2><button class="btn-secondary" @onclick="CloseSelection">Cerrar</button></div>
            @if (selectedVacation.PersonalDataVisible)
            {
                <div class="detail-grid"><div><span>Funcionario</span><strong>@selectedVacation.EmployeeNumber · @selectedVacation.EmployeeName</strong></div><div><span>Empresa / departamento</span><strong>@selectedVacation.Company · @selectedVacation.Department</strong></div><div><span>Intervalo</span><strong>@selectedVacation.StartDate.ToString("dd/MM/yyyy") – @selectedVacation.EndDate.ToString("dd/MM/yyyy")</strong></div><div><span>Días reservados</span><strong>@selectedVacation.RequestedDays</strong></div></div>
            }
            else { <div class="notice">La cuenta administrativa consulta el circuito sin acceder a datos personales.</div> }
            @HistoryTable(selectedVacation.History)
            @if (selectedVacation.CanAct) { @DecisionButtons(ApproveVacationAsync, RejectVacationAsync) }
        </section>
    }
    @VacationTables()
}
else
{
    @if (selectedPermission is not null)
    {
        <section class="panel editor-accent">
            <div class="panel-title"><h2>Detalle del circuito del permiso</h2><button class="btn-secondary" @onclick="CloseSelection">Cerrar</button></div>
            @if (selectedPermission.PersonalDataVisible)
            {
                <div class="detail-grid"><div><span>Funcionario</span><strong>@selectedPermission.EmployeeNumber · @selectedPermission.EmployeeName</strong></div><div><span>Empresa / departamento</span><strong>@selectedPermission.Company · @selectedPermission.Department</strong></div><div><span>Tipo</span><strong>@TypeText(selectedPermission.PermissionType)</strong></div><div><span>Intervalo</span><strong>@PermissionInterval(selectedPermission)</strong></div><div><span>Cantidad</span><strong>@PermissionQuantity(selectedPermission)</strong></div><div><span>Motivo</span><strong>@selectedPermission.Reason</strong></div></div>
            }
            else { <div class="notice">La cuenta administrativa consulta el circuito sin acceder a datos personales.</div> }
            @HistoryTable(selectedPermission.History)
            @if (selectedPermission.CanAct) { @DecisionButtons(ApprovePermissionAsync, RejectPermissionAsync) }
        </section>
    }
    @PermissionTables()
}

@code {
    private string activeType = "vacations";
    private List<VacationDecisionItem> vacations = [];
    private List<PermissionDecisionItem> permissions = [];
    private VacationDecisionItem? selectedVacation;
    private PermissionDecisionItem? selectedPermission;
    private string comment = string.Empty;
    private string message = string.Empty;
    private bool hasError;

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        vacations = await VacationRequests.GetWorkflowRequestsAsync();
        permissions = await PermissionRequests.GetWorkflowRequestsAsync();
    }
    private void ChangeType(string value) { activeType = value; CloseSelection(); }
    private void CloseSelection() { selectedVacation = null; selectedPermission = null; comment = string.Empty; }
    private void Select(VacationDecisionItem item) { selectedVacation = item; selectedPermission = null; comment = string.Empty; }
    private void Select(PermissionDecisionItem item) { selectedPermission = item; selectedVacation = null; comment = string.Empty; }

    private async Task ApproveVacationAsync()
    {
        var id = selectedVacation!.Id;
        await ResolveAsync(() => VacationRequests.ApproveAsync(id, comment));
        if (!hasError) message = vacations.Single(x => x.Id == id).Status == VacationRequestStatuses.Approved
            ? "Vacaciones aprobadas definitivamente; la reserva se convirtió en consumo."
            : "Nivel aprobado; la reserva permanece hasta la decisión final.";
    }
    private Task RejectVacationAsync() => ResolveAsync(() => VacationRequests.RejectAsync(selectedVacation!.Id, comment), "Vacaciones rechazadas; la reserva fue liberada.");
    private async Task ApprovePermissionAsync()
    {
        var id = selectedPermission!.Id;
        await ResolveAsync(() => PermissionRequests.ApproveAsync(id, comment));
        if (!hasError) message = permissions.Single(x => x.Id == id).Status == PermissionRequestStatuses.Approved
            ? "Permiso aprobado definitivamente. No se generaron movimientos de vacaciones."
            : "Nivel del permiso aprobado; continúa pendiente del siguiente nivel.";
    }
    private Task RejectPermissionAsync() => ResolveAsync(() => PermissionRequests.RejectAsync(selectedPermission!.Id, comment), "Permiso rechazado.");
    private async Task ResolveAsync(Func<Task> action, string success = "")
    {
        try { await action(); CloseSelection(); await LoadAsync(); hasError = false; if (!string.IsNullOrWhiteSpace(success)) message = success; }
        catch (Exception ex) { hasError = true; message = ex.Message; }
    }

    private RenderFragment DecisionButtons(Func<Task> approve, Func<Task> reject) => @<div><label><span>Comentario de decisión</span><textarea @bind="comment"></textarea></label><div><button class="btn-primary" @onclick="approve">Aprobar nivel</button> <button class="btn-danger" @onclick="reject">Rechazar solicitud</button></div></div>;
    private RenderFragment HistoryTable(IReadOnlyList<VacationDecisionHistoryItem> history) => @<div><h3>Historial</h3><div class="table-wrap"><table><thead><tr><th>Orden</th><th>Nivel</th><th>Estado</th><th>Usuario</th><th>Comentario</th></tr></thead><tbody>@foreach (var step in history){<tr><td>@step.Sequence</td><td>@step.Level</td><td>@StepText(step.Status)</td><td>@(string.IsNullOrWhiteSpace(step.DecidedBy) ? "—" : step.DecidedBy)</td><td>@(string.IsNullOrWhiteSpace(step.Comment) ? "—" : step.Comment)</td></tr>}</tbody></table></div></div>;
    private RenderFragment VacationTables() => @<div><section class="panel"><div class="panel-title"><h2>Vacaciones pendientes de mi aprobación</h2><span>@vacations.Count(x => x.CanAct)</span></div><div class="table-wrap"><table><thead><tr><th>Funcionario</th><th>Departamento</th><th>Intervalo</th><th>Días</th><th>Nivel</th><th></th></tr></thead><tbody>@if(!vacations.Any(x => x.CanAct)){<tr><td colspan="6" class="empty">No hay vacaciones pendientes dentro de su alcance.</td></tr>}@foreach(var item in vacations.Where(x => x.CanAct)){<tr><td>@item.EmployeeNumber<small>@item.EmployeeName</small></td><td>@item.Company<small>@item.Department</small></td><td>@item.StartDate.ToString("dd/MM/yyyy")–@item.EndDate.ToString("dd/MM/yyyy")</td><td>@item.RequestedDays</td><td>@item.PendingLevel</td><td><button class="link-button" @onclick="() => Select(item)">Resolver</button></td></tr>}</tbody></table></div></section><section class="panel"><div class="panel-title"><h2>Vacaciones procesadas y estado administrativo</h2><span>@vacations.Count(x => !x.CanAct)</span></div><div class="table-wrap"><table><thead><tr><th>Solicitud</th><th>Intervalo</th><th>Estado</th><th>Nivel</th><th></th></tr></thead><tbody>@foreach(var item in vacations.Where(x => !x.CanAct)){<tr><td>@item.EmployeeName</td><td>@item.StartDate.ToString("dd/MM/yyyy")–@item.EndDate.ToString("dd/MM/yyyy")</td><td>@StatusText(item.Status)</td><td>@(string.IsNullOrWhiteSpace(item.PendingLevel) ? "—" : item.PendingLevel)</td><td><button class="link-button" @onclick="() => Select(item)">Ver circuito</button></td></tr>}</tbody></table></div></section></div>;
    private RenderFragment PermissionTables() => @<div><section class="panel"><div class="panel-title"><h2>Permisos pendientes de mi aprobación</h2><span>@permissions.Count(x => x.CanAct)</span></div><div class="table-wrap"><table><thead><tr><th>Funcionario</th><th>Departamento</th><th>Tipo</th><th>Intervalo</th><th>Cantidad</th><th>Nivel</th><th></th></tr></thead><tbody>@if(!permissions.Any(x => x.CanAct)){<tr><td colspan="7" class="empty">No hay permisos pendientes dentro de su alcance.</td></tr>}@foreach(var item in permissions.Where(x => x.CanAct)){<tr><td>@item.EmployeeNumber<small>@item.EmployeeName</small></td><td>@item.Company<small>@item.Department</small></td><td>@TypeText(item.PermissionType)</td><td>@PermissionInterval(item)</td><td>@PermissionQuantity(item)</td><td>@item.PendingLevel</td><td><button class="link-button" @onclick="() => Select(item)">Resolver</button></td></tr>}</tbody></table></div></section><section class="panel"><div class="panel-title"><h2>Permisos procesados y estado administrativo</h2><span>@permissions.Count(x => !x.CanAct)</span></div><div class="table-wrap"><table><thead><tr><th>Solicitud</th><th>Tipo</th><th>Intervalo</th><th>Estado</th><th>Nivel</th><th></th></tr></thead><tbody>@foreach(var item in permissions.Where(x => !x.CanAct)){<tr><td>@item.EmployeeName</td><td>@TypeText(item.PermissionType)</td><td>@PermissionInterval(item)</td><td>@StatusText(item.Status)</td><td>@(string.IsNullOrWhiteSpace(item.PendingLevel) ? "—" : item.PendingLevel)</td><td><button class="link-button" @onclick="() => Select(item)">Ver circuito</button></td></tr>}</tbody></table></div></section></div>;
    private static string PermissionQuantity(PermissionDecisionItem item) => item.Unit == PermissionRequestUnits.Hours ? $"{item.RequestedMinutes / 60} h {item.RequestedMinutes % 60:D2} min" : $"{item.RequestedDays} día(s)";
    private static string PermissionInterval(PermissionDecisionItem item) => item.Unit == PermissionRequestUnits.Hours ? $"{item.StartDate:dd/MM/yyyy} {item.StartTime:HH\\:mm}–{item.EndTime:HH\\:mm}" : $"{item.StartDate:dd/MM/yyyy}–{item.EndDate:dd/MM/yyyy}";
    private static string TypeText(string value) => value == PermissionRequestTypes.Paid ? "Con goce" : "Sin goce";
    private static string StatusText(string value) => value switch { VacationRequestStatuses.Pending => "Pendiente", VacationRequestStatuses.Approved => "Aprobada", VacationRequestStatuses.Rejected => "Rechazada", VacationRequestStatuses.Cancelled => "Cancelada", _ => value };
    private static string StepText(string value) => value switch { VacationApprovalStepStatuses.Waiting => "En espera", VacationApprovalStepStatuses.Pending => "Pendiente", VacationApprovalStepStatuses.Approved => "Aprobado", VacationApprovalStepStatuses.Rejected => "Rechazado", VacationApprovalStepStatuses.Cancelled => "Cancelado", _ => value };
}
