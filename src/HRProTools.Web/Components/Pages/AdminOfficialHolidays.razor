@page "/admin/feriados-oficiales"
@attribute [Authorize(Policy = AppPolicies.GlobalAdministration)]
@using HRProTools.Web.Components.Shared
@inject ReferenceAdministrationService Administration
<PageTitle>Feriados oficiales - HR ProTools</PageTitle>
<div class="page-heading"><div><span class="eyebrow">Administración global</span><h1>Feriados oficiales</h1><p>Calendario nacional de Paraguay. La fecha efectiva puede corregirse para cualquier feriado, conservando su historial.</p></div><button class="btn-primary" @onclick="New">Agregar feriado</button></div>
@if(message.Length>0){<div class="notice @(error?"notice-error":"notice-success")">@message</div>}
<section class="panel"><label><span>Año</span><input type="number" min="1900" max="2200" @bind="year" @bind:after="LoadAsync"/></label>
<div class="notice"><strong>@(status?.IsConfirmed==true?"Calendario confirmado":"Feriados conocidos disponibles · verificación anual pendiente")</strong><p>@(status?.VerificationNote??OfficialHolidayRecurrence.PendingMessage)</p></div>
<AnnualHolidayCalendar Year="year" Days="@CalendarDays"/>
<div class="table-wrap"><table><thead><tr><th>Feriado / año</th><th>Fecha original</th><th>Fecha efectiva</th><th>Tipo / estado</th><th>Fundamento / disposición</th><th>Modificado</th><th></th></tr></thead><tbody>
@foreach(var x in Current){<tr><td>@x.Name<small>@x.Year</small></td><td>@x.OriginalDate.ToString("dd/MM/yyyy")</td><td>@x.ObservedDate.ToString("dd/MM/yyyy")</td><td>@OfficialHolidayRecurrence.State(x)<small>@(x.IsActive?"Activo":"Inactivo")</small></td><td><a href="@x.SourceUrl" target="_blank" rel="noopener">@x.LegalBasis</a><small>@x.Disposition</small></td><td>@(x.Revision==0?"Calculado al consultar":x.ChangedAtUtc.ToString("u"))</td><td><button class="link-button" @onclick="()=>Edit(x)">Editar / cambiar fecha</button><button class="link-button" @onclick="()=>history=x.HolidayId">Historial</button></td></tr>}
</tbody></table></div></section>
<section class="panel"><details><summary>Verificar integridad del calendario anual</summary><p>Confirmar requiere comprobar las normas y disposiciones del año completo. Cada cambio posterior vuelve a marcarlo pendiente.</p><div class="form-grid"><label><span>Fuente documental HTTPS</span><input type="url" @bind="confirmationSource"/></label><label><span>Resultado de la verificación</span><textarea @bind="confirmationNote" maxlength="1000"></textarea></label><label><span>Estado</span><select @bind="confirmed"><option value="true">Confirmado</option><option value="false">Pendiente / incompleto</option></select></label></div><button class="btn-secondary" @onclick="ConfirmAsync">Guardar verificación</button></details></section>
@if(history.HasValue){<section class="panel"><div class="panel-title"><h2>Historial del feriado</h2><button class="link-button" @onclick="()=>history=null">Cerrar</button></div><div class="table-wrap"><table><thead><tr><th>Versión / fecha</th><th>Original → efectiva</th><th>Cambio</th><th>Fuente / motivo</th></tr></thead><tbody>@foreach(var x in versions.Where(x=>x.HolidayId==history).OrderByDescending(x=>x.Revision)){<tr><td>@(x.Revision==0?"Base legal calculada":$"{x.Revision} · {x.ChangedAtUtc:u}")<small>@(x.Revision==0?"Sin publicación manual":$"Actor: {x.ChangedByUserId}")</small></td><td>@x.OriginalDate.ToString("dd/MM/yyyy") → @x.ObservedDate.ToString("dd/MM/yyyy")<small>@x.Name · @(x.IsActive?"Activo":"Inactivo")</small></td><td>@(x.Revision==0?OfficialHolidayRecurrence.State(x):Change(x.ChangeKind))<small>@x.Disposition</small></td><td><a href="@x.SourceUrl" target="_blank" rel="noopener">@x.LegalBasis</a><small>@x.ChangeReason</small></td></tr>}</tbody></table></div></section>}
@if(editing){<section class="panel editor-accent"><div class="panel-title"><h2>@(expected.HasValue?"Nueva revisión del feriado":"Nuevo feriado oficial")</h2><button class="link-button" @onclick="()=>editing=false">Cancelar</button></div>
<div class="notice">Un traslado oficial requiere disposición normativa. Una corrección administrativa no equivale a un decreto. Solo se usa la fecha efectiva; la conmemorativa no crea otro día de descanso. Se conservarán las instantáneas y consumos de solicitudes existentes, aunque abarquen fechas futuras.</div>
<div class="form-grid"><label><span>Nombre</span><input @bind="form.Name" maxlength="200"/></label><label><span>Fecha original / conmemorativa</span><InputDate @bind-Value="form.OriginalDate"/></label><label><span>Fecha efectiva</span><InputDate @bind-Value="form.ObservedDate"/></label><label><span>Tipo</span><select @bind="form.Kind"><option value="NATIONAL">Nacional</option><option value="MOVED">Trasladado</option><option value="EXTRAORDINARY">Extraordinario</option></select></label><label><span>Clase de cambio</span><select @bind="form.ChangeKind">@if(!expected.HasValue){<option value="INITIAL">Alta inicial</option>}<option value="OFFICIAL_MOVE">Traslado oficial</option><option value="CORRECTION">Corrección administrativa</option></select></label><label><span>Fundamento legal</span><input @bind="form.LegalBasis" maxlength="500"/></label><label><span>Decreto / disposición</span><input @bind="form.Disposition" maxlength="500"/></label><label><span>Fuente oficial / documental HTTPS</span><input type="url" @bind="form.SourceUrl" maxlength="1500"/></label><label><span>Estado</span><select @bind="form.IsActive"><option value="true">Activo</option><option value="false">Inactivo</option></select></label><label class="span-full"><span>Motivo del cambio</span><textarea @bind="form.ChangeReason" maxlength="1000"></textarea></label></div><button class="btn-primary" disabled="busy" @onclick="SaveAsync">Guardar revisión</button></section>}
@code{
 private int year=GlobalReferenceQueries.Today.Year;private List<OfficialHolidayVersion>versions=[];private OfficialCalendarYear? status;private OfficialHolidayVersion form=new();private Guid? expected,history;private bool editing,busy,error,confirmed;private string message="",confirmationSource="",confirmationNote="";
 private IEnumerable<OfficialHolidayVersion> Current=>versions.GroupBy(x=>x.HolidayId).Select(g=>g.MaxBy(x=>x.Revision)!).Where(x=>x.Year==year).OrderBy(x=>x.ObservedDate);
 private IReadOnlyList<CalendarHoliday> CalendarDays=>Current.Where(x=>x.IsActive).Select(x=>new CalendarHoliday(x.HolidayId,x.ObservedDate,x.Name,"OFFICIAL",x.OriginalDate,x.SourceUrl,false)).ToList();
 protected override async Task OnInitializedAsync()=>await LoadAsync();
 private async Task LoadAsync(){if(year is <1900 or >2200){message="Seleccione un año entre 1900 y 2200.";error=true;return;}var result=await Administration.GetHolidaysAsync(year);versions=result.Versions;status=result.Year;confirmationSource=status?.SourceUrl??"";confirmationNote=status?.VerificationNote??"";confirmed=status?.IsConfirmed==true;}
 private void New(){form=new(){Year=year,OriginalDate=new(year,1,1),ObservedDate=new(year,1,1)};expected=null;editing=true;}
 private void Edit(OfficialHolidayVersion x){form=new(){HolidayId=x.HolidayId,Year=x.Year,Name=x.Name,OriginalDate=x.OriginalDate,ObservedDate=x.ObservedDate,Kind=x.Kind,IsActive=x.IsActive,LegalBasis=x.LegalBasis,SourceUrl=x.SourceUrl,Disposition=x.Disposition,ChangeKind="CORRECTION"};expected=x.Id;editing=true;}
 private async Task SaveAsync(){await RunAsync(async()=>{form.Year=form.ObservedDate.Year;await Administration.SaveHolidayAsync(form,expected);year=form.Year;editing=false;},"Revisión guardada. Se conservó el historial; el año queda pendiente de verificación.");}
 private async Task ConfirmAsync()=>await RunAsync(()=>Administration.ConfirmYearAsync(year,confirmed,confirmationSource,confirmationNote),"Verificación anual guardada.");
 private async Task RunAsync(Func<Task> action,string ok){if(busy)return;busy=true;try{await action();await LoadAsync();message=ok;error=false;}catch(Exception ex){message=ex.Message;error=true;}finally{busy=false;}}
 private static string Kind(string x)=>x switch{"MOVED"=>"Trasladado","EXTRAORDINARY"=>"Extraordinario",_=>"Nacional"};
 private static string Change(string x)=>x switch{"OFFICIAL_MOVE"=>"Traslado oficial","CORRECTION"=>"Corrección administrativa",_=>"Alta inicial"};
}
