@page "/tenant/ausencias"
@attribute [Authorize(Roles = AppRoles.Approver + "," + AppRoles.HumanResources)]
@inject AbsenceService Absences

<PageTitle>Ausencias - HR ProTools</PageTitle>
<div class="page-heading"><div><span class="eyebrow">Gestion operativa</span><h1>Ausencias</h1><p>Registro dentro del alcance autorizado y revision final exclusiva de Recursos Humanos.</p></div></div>
@if(!string.IsNullOrWhiteSpace(message)){<div class="notice @(error?"notice-error":"notice-success")">@message</div>}
<section class="panel editor-accent"><h2>Registrar ausencia</h2><div class="form-grid">
    <label><span>Funcionario</span><select @bind="employmentId"><option value="@Guid.Empty">Seleccione</option>@foreach(var employee in employees){<option value="@employee.Id">@employee.EmployeeNumber · @employee.Name (@employee.Department)</option>}</select></label>
    <label><span>Fecha inicial</span><input type="date" @bind="start" /></label><label><span>Fecha final</span><input type="date" @bind="end" /></label>
    <label><span>Tipo declarado</span><select @bind="type"><option value="MEDICAL">Ausencia medica</option><option value="UNJUSTIFIED">Ausencia injustificada</option><option value="OTHER_JUSTIFIED">Otra ausencia justificada</option></select></label>
    <label><span>Motivo o comentario</span><textarea @bind="reason"></textarea></label>
    <label class="checkbox-field"><span>Conflictos</span><span><input type="checkbox" @bind="confirmConflict"/> Confirmar registro si existe permiso o vacacion superpuesta</span></label>
</div><p class="field-help">La confirmacion conserva las solicitudes existentes y registra solamente la ausencia. Las ausencias duplicadas nunca se aceptan.</p><button class="btn-primary" @onclick="CreateAsync">Registrar ausencia</button></section>

@if(selected is not null){<section class="panel editor-accent"><div class="panel-title"><h2>Detalle de ausencia</h2><button class="btn-secondary" @onclick="()=>selected=null">Cerrar</button></div>
<div class="detail-grid"><div><span>Funcionario</span><strong>@selected.EmployeeNumber · @selected.EmployeeName</strong></div><div><span>Empresa / departamento</span><strong>@selected.Company · @selected.Department</strong></div><div><span>Intervalo</span><strong>@selected.StartDate.ToString("dd/MM/yyyy") – @selected.EndDate.ToString("dd/MM/yyyy")</strong></div><div><span>Estado</span><strong>@StatusText(selected.Status)</strong></div><div><span>Tipo declarado</span><strong>@TypeText(selected.DeclaredType)</strong></div><div><span>Motivo</span><strong>@selected.Reason</strong></div></div>
<AuthorizeView Roles="@AppRoles.HumanResources"><Authorized><h3>Resolucion RR. HH.</h3><div class="form-grid"><label><span>Clasificacion final</span><select @bind="finalClassification"><option value="MEDICAL">Ausencia medica</option><option value="OTHER_JUSTIFIED">Otra ausencia justificada</option><option value="UNJUSTIFIED">Ausencia injustificada</option></select></label><label><span>Estado final</span><select @bind="finalStatus"><option value="JUSTIFIED">Justificada</option><option value="UNJUSTIFIED">Injustificada</option></select></label><label><span>Comentario</span><textarea @bind="resolutionComment"></textarea></label></div><button class="btn-primary" @onclick="ReviewAsync">Guardar resolucion</button> <button class="btn-danger" @onclick="CancelAsync">Cancelar registro</button>
<h3>Documento justificativo</h3><div class="logo-actions"><InputFile OnChange="ChooseFile" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png"/><button class="btn-secondary" disabled="@(upload is null)" @onclick="UploadAsync">Cargar y escanear</button></div>
@if(selected.Documents.Count>0){<div class="table-wrap"><table><thead><tr><th>Archivo</th><th>Tamano</th><th>Antivirus</th><th></th></tr></thead><tbody>@foreach(var doc in selected.Documents){<tr><td>@doc.FileName<small>SHA-256 @doc.Sha256</small></td><td>@(doc.Size/1024) KB</td><td>@doc.AntivirusStatus</td><td>@if(doc.CanDownload){<a class="link-button" href="@($"/tenant/ausencias/documentos/{doc.Id}")">Descargar</a>}else{<span class="status pending">Descarga bloqueada</span>}</td></tr>}</tbody></table></div>}</Authorized></AuthorizeView>
<h3>Historial</h3><div class="table-wrap"><table><thead><tr><th>Fecha</th><th>Cambio</th><th>Usuario</th><th>Comentario</th></tr></thead><tbody>@foreach(var history in selected.History){<tr><td>@history.ChangedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@StatusText(history.PreviousStatus) → @StatusText(history.NewStatus)</td><td>@history.ChangedBy</td><td>@history.Comment</td></tr>}</tbody></table></div></section>}

<section class="panel"><div class="panel-title"><h2>Ausencias dentro de mi alcance</h2><span>@items.Count</span></div><div class="table-wrap"><table><thead><tr><th>Funcionario</th><th>Empresa / departamento</th><th>Fechas</th><th>Tipo</th><th>Estado</th><th></th></tr></thead><tbody>@if(items.Count==0){<tr><td colspan="6" class="empty">No existen ausencias dentro de su alcance.</td></tr>}@foreach(var item in items){<tr><td>@item.EmployeeNumber<small>@item.EmployeeName</small></td><td>@item.Company<small>@item.Department</small></td><td>@item.StartDate.ToString("dd/MM/yyyy")–@item.EndDate.ToString("dd/MM/yyyy")</td><td>@TypeText(item.DeclaredType)</td><td>@StatusText(item.Status)</td><td><button class="link-button" @onclick="()=>Select(item)">Ver detalle</button></td></tr>}</tbody></table></div></section>

@code{
    private List<AbsenceEmployeeOption> employees=[];private List<AbsenceView> items=[];private AbsenceView? selected;private Guid employmentId;private DateOnly start=ParaguayVacationRules.ParaguayToday(),end=ParaguayVacationRules.ParaguayToday();private string type=AbsenceTypes.OtherJustified,reason="",message="",finalClassification=AbsenceTypes.OtherJustified,finalStatus=AbsenceStatuses.Justified,resolutionComment="";private bool error,confirmConflict;private IBrowserFile? upload;
    protected override async Task OnInitializedAsync()=>await LoadAsync();private async Task LoadAsync(){employees=(await Absences.GetOperationalEmployeesAsync()).ToList();items=await Absences.GetOperationalAsync();if(selected is not null)selected=items.SingleOrDefault(x=>x.Id==selected.Id);}
    private void Select(AbsenceView item){selected=item;finalClassification=item.FinalClassification??item.DeclaredType;finalStatus=item.Status==AbsenceStatuses.Unjustified?AbsenceStatuses.Unjustified:AbsenceStatuses.Justified;resolutionComment=item.ResolutionComment;upload=null;}
    private async Task CreateAsync()=>await RunAsync(async()=>{if(employmentId==Guid.Empty)throw new InvalidOperationException("Seleccione un funcionario.");await Absences.CreateOperationalAsync(employmentId,start,end,type,reason,confirmConflict);reason="";confirmConflict=false;message="Ausencia registrada para revision.";});
    private async Task ReviewAsync()=>await RunAsync(async()=>{await Absences.ReviewAsync(selected!.Id,finalClassification,finalStatus,resolutionComment);message="Clasificacion final guardada con historial.";});
    private async Task CancelAsync()=>await RunAsync(async()=>{await Absences.MarkCancelledAsync(selected!.Id,string.IsNullOrWhiteSpace(resolutionComment)?"Correccion del registro":resolutionComment);message="Ausencia cancelada sin eliminar su historial.";});
    private void ChooseFile(InputFileChangeEventArgs e)=>upload=e.File;
    private async Task UploadAsync()=>await RunAsync(async()=>{if(upload is null)throw new InvalidOperationException("Seleccione un archivo.");await using var stream=upload.OpenReadStream(AbsenceDocumentValidator.MaxSize);using var memory=new MemoryStream();await stream.CopyToAsync(memory);await Absences.UploadDocumentAsync(selected!.Id,upload.Name,upload.ContentType,memory.ToArray());upload=null;message="Documento almacenado con su estado antivirus.";});
    private async Task RunAsync(Func<Task> action){try{await action();error=false;await LoadAsync();}catch(Exception ex){error=true;message=ex.Message;}}
    private static string TypeText(string v)=>v switch{AbsenceTypes.Medical=>"Medica",AbsenceTypes.Unjustified=>"Injustificada",AbsenceTypes.OtherJustified=>"Otra justificada",_=>v};private static string StatusText(string v)=>v switch{""=>"Inicio",AbsenceStatuses.Declared=>"Declarada",AbsenceStatuses.PendingReview=>"Pendiente de revision",AbsenceStatuses.Justified=>"Justificada",AbsenceStatuses.Unjustified=>"Injustificada",AbsenceStatuses.Cancelled=>"Cancelada",_=>v};
}
