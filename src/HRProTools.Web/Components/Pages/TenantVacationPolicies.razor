@page "/tenant/vacaciones/politicas"
@attribute [Authorize(Policy = AppPolicies.TenantAdministration)]
@inject VacationService Vacations
@inject TenantDataService Data
<PageTitle>Políticas de vacaciones - HR ProTools</PageTitle>
<div class="page-heading"><div><span class="eyebrow">Administración tenant</span><h1>Políticas de vacaciones</h1><p>Los mínimos legales 12, 18 y 30 no son editables. Configure únicamente días adicionales.</p></div><button class="btn-secondary" @onclick="GenerateAsync">Generar períodos pendientes de causación</button></div>
@if(!string.IsNullOrWhiteSpace(message)){<div class="notice @(error?"notice-error":"notice-success")">@message</div>}
<section class="panel"><h2>Nueva vigencia</h2><div class="form-grid"><label><span>Empresa</span><select @bind="companyId">@foreach(var x in companies){<option value="@x.Id">@x.LegalName</option>}</select></label><label><span>Vigente desde</span><InputDate @bind-Value="effectiveFrom"/></label><label><span>Adicional: 1 a 5 años</span><InputNumber @bind-Value="days1"/></label><label><span>Adicional: 6 a 10 años</span><InputNumber @bind-Value="days6"/></label><label><span>Adicional: más de 10 años</span><InputNumber @bind-Value="days11"/></label></div><button class="btn-primary" @onclick="SaveAsync">Guardar nueva versión</button></section>
<section class="panel"><div class="panel-title"><h2>Versiones</h2><span>@policies.Count</span></div><div class="table-wrap"><table><thead><tr><th>Empresa</th><th>Vigente desde</th><th>1–5 años</th><th>6–10 años</th><th>Más de 10</th></tr></thead><tbody>@foreach(var x in policies){<tr><td>@x.Company.LegalName</td><td>@x.EffectiveFrom.ToString("dd/MM/yyyy")</td><td>12 + @x.AdditionalDaysYears1To5</td><td>18 + @x.AdditionalDaysYears6To10</td><td>30 + @x.AdditionalDaysOver10</td></tr>}</tbody></table></div></section>
@code{private List<Company>companies=[];private List<VacationPolicy>policies=[];private Guid companyId;private DateOnly effectiveFrom=DateOnly.FromDateTime(DateTime.Today);private decimal days1,days6,days11;private string message="";private bool error;
protected override async Task OnInitializedAsync(){companies=await Data.GetCompaniesAsync(false);companyId=companies.FirstOrDefault()?.Id??Guid.Empty;await LoadAsync();}private async Task LoadAsync()=>policies=await Vacations.GetPoliciesAsync();
private async Task SaveAsync(){try{await Vacations.SavePolicyAsync(companyId,effectiveFrom,days1,days6,days11);message="Nueva versión guardada sin modificar períodos anteriores.";error=false;await LoadAsync();}catch(Exception ex){message=ex.Message;error=true;}}
private async Task GenerateAsync(){try{var count=await Vacations.GenerateDuePeriodsAsync();message=$"Se generaron {count} períodos nuevos. El proceso es idempotente.";error=false;}catch(Exception ex){message=ex.Message;error=true;}}}
