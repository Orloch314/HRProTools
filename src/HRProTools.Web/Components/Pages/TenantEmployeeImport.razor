@page "/tenant/importacion"
@attribute [Authorize(Policy = AppPolicies.TenantAdministration)]
@inject EmployeeExcelImportService Importer
<PageTitle>Importación Excel - HR ProTools</PageTitle>
<div class="page-heading"><div><span class="eyebrow">Administración tenant</span><h1>Importación Excel</h1><p>Incorpore funcionarios nuevos y sus períodos históricos sin sobrescribir datos existentes.</p></div><a class="btn-secondary" href="tenant/importacion/plantilla">Descargar plantilla</a></div>
@if(!string.IsNullOrWhiteSpace(message)){<div class="notice @(error?"notice-error":"notice-success")">@message</div>}
<section class="panel"><h2>1. Seleccionar y validar</h2><p class="field-help">Archivo .xlsx de hasta 10 MB. Se escanea con ClamAV antes de leer su contenido.</p><InputFile OnChange="ValidateAsync" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"/></section>
@if(preview is not null){<section class="panel"><h2>2. Resultado de validación</h2><div class="detail-grid"><div><span>Funcionarios nuevos</span><strong>@preview.Employees.Count</strong></div><div><span>Períodos históricos</span><strong>@preview.Vacations.Count</strong></div><div><span>Errores</span><strong>@preview.Errors.Count</strong></div></div>
@if(preview.Errors.Count>0){<div class="table-wrap"><table><thead><tr><th>Hoja</th><th>Fila</th><th>Error</th></tr></thead><tbody>@foreach(var x in preview.Errors){<tr><td>@x.Sheet</td><td>@x.Row</td><td>@x.Message</td></tr>}</tbody></table></div>}else{<button class="btn-primary" @onclick="ConfirmAsync" disabled="@saving">@(saving?"Importando...":"Confirmar importación")</button>}</section>}
@code{private EmployeeImportPreview? preview;private string message="";private bool error,saving;
private async Task ValidateAsync(InputFileChangeEventArgs e){try{var f=e.File;if(f.Size>EmployeeExcelImportService.MaximumBytes)throw new InvalidOperationException("El archivo no puede superar 10 MB.");await using var s=f.OpenReadStream(EmployeeExcelImportService.MaximumBytes);using var m=new MemoryStream();await s.CopyToAsync(m);preview=await Importer.ValidateAsync(f.Name,m.ToArray());message=preview.IsValid?"Archivo válido. Revise el resumen y confirme.":"El archivo contiene errores; no se guardó ningún dato.";error=!preview.IsValid;}catch(Exception ex){preview=null;message=ex.Message;error=true;}}
private async Task ConfirmAsync(){if(preview is null)return;saving=true;try{var id=await Importer.ConfirmAsync(preview);message=$"Importación completada. Lote {id}.";error=false;preview=null;}catch(Exception ex){message=ex.Message;error=true;}finally{saving=false;}}}
