@page "/Account/AcceptInvitation"
@attribute [AllowAnonymous]
@inject InvitationAcceptanceService Invitations

<PageTitle>Completar invitación - HR ProTools</PageTitle>
<div class="auth-card">
    <img src="images/logo.png" alt="HR ProTools" />
    @if (completed)
    {
        <h1>Cuenta activada</h1>
        <div class="notice notice-success" role="status">@message</div>
        <a class="btn-primary" href="Account/Login">Ir al inicio de sesión</a>
    }
    else
    {
        <h1>Complete su invitación</h1>
        <p>Defina su contraseña para activar el acceso. El enlace tiene una vigencia de 24 horas.</p>
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="notice notice-error" role="alert">@message</div>
        }
        <EditForm Model="Input" OnValidSubmit="AcceptAsync" FormName="accept-invitation" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary" role="alert" />
            <label for="Invitation.Password"><span>Nueva contraseña</span></label>
            <PasswordInput Id="Invitation.Password"
                           @bind-Value="Input.Password"
                           Autocomplete="new-password" />
            <ValidationMessage For="() => Input.Password" class="validation-message" />
            <label for="Invitation.ConfirmPassword"><span>Confirmar contraseña</span></label>
            <PasswordInput Id="Invitation.ConfirmPassword"
                           @bind-Value="Input.ConfirmPassword"
                           Autocomplete="new-password" />
            <ValidationMessage For="() => Input.ConfirmPassword" class="validation-message" />
            <button class="btn-primary invitation-submit" type="submit">Activar acceso</button>
        </EditForm>
    }
</div>

@code {
    [SupplyParameterFromQuery] public string? Code { get; set; }
    [SupplyParameterFromQuery] public string? Email { get; set; }

    [SupplyParameterFromForm]
    private AcceptInvitationModel Input { get; set; } = default!;

    private string message = string.Empty;
    private bool completed;

    protected override void OnInitialized() => Input ??= new();

    private async Task AcceptAsync()
    {
        var result = await Invitations.AcceptAsync(Email, Code, Input.Password);
        completed = result.Succeeded;
        message = result.Message;
    }
}
