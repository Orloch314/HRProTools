---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
interface Props { title: string; description?: string; }
const { title, description = 'Simplificá la gestión de vacaciones, permisos, ausencias y aprobaciones de tu empresa con HR ProTools.' } = Astro.props;
---
<!doctype html><html lang="es-PY"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#08243d"/><title>{title} | HR ProTools</title><link rel="icon" type="image/png" href="/images/logo.png"/></head><body><a class="skip-link" href="#contenido">Saltar al contenido</a><Header/><main id="contenido"><slot/></main><Footer/></body></html>
