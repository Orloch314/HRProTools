---
interface Props { screen?: 'dashboard' | 'funcionarios' | 'circuito'; }
const {screen = 'dashboard'} = Astro.props;
const titles = {dashboard:'Panel de Recursos Humanos', funcionarios:'Funcionarios', circuito:'Circuito de solicitudes'};
---
<figure class:list={['product-preview', screen]}>
 <div class="product-window"><div class="product-sidebar"><img src="/images/logo.png" width="44" height="44" alt=""/><strong>HR ProTools</strong><span class:list={['side-item', {selected:screen==='dashboard'}]}>Dashboard</span><span class:list={['side-item', {selected:screen==='funcionarios'}]}>Funcionarios</span><span class="side-item">Organización</span><span class:list={['side-item', {selected:screen==='circuito'}]}>Solicitudes</span><span class="side-item">Reportes</span></div><div class="product-main"><div class="product-bar"><span>Gestión del grupo</span><span>Entorno ilustrativo</span></div><div class="product-body"><span class="product-eyebrow">ADMINISTRACIÓN TENANT</span><h3>{titles[screen]}</h3>
 {screen==='dashboard' ? <><div class="demo-metrics"><div><span>Solicitudes pendientes</span><strong>12</strong></div><div><span>Vacaciones aprobadas</span><strong>8</strong></div><div><span>Ausencias en revisión</span><strong>4</strong></div></div><div class="demo-panel"><h4>Alertas operativas</h4><div class="demo-row"><span>Solicitudes para revisar<small>Dentro del alcance de tu rol</small></span><span class="badge pending">Pendiente</span></div><div class="demo-row"><span>Documentación por completar<small>Seguimiento de Recursos Humanos</small></span><span class="badge blue">En revisión</span></div></div><div class="demo-panel"><h4>Reporte de permisos</h4><p>Filtros por empresa, departamento, fecha y estado.</p><span class="demo-link">Exportación Excel</span></div></> : screen==='funcionarios' ? <><div class="demo-toolbar"><span>Nómina básica</span><span class="demo-button">Nuevo funcionario</span></div><div class="demo-panel"><div class="demo-row table-head"><span>Legajo / funcionario</span><span>Departamento</span><span>Estado</span></div>{['001','002','003'].map((id,i)=><div class="demo-row"><span><strong>{id}</strong><small>Persona de ejemplo {i+1}</small></span><span>{['Operaciones','Administración','Comercial'][i]}</span><span class="badge">Activo</span></div>)}</div><div class="demo-tabs"><span>Datos generales</span><span>Historial laboral</span><span>Historial salarial</span></div></> : <><p class="demo-description">Vacaciones · ejemplo de recorrido</p><div class="circuit-steps"><div><span class="step-mark">✓</span><div><strong>Solicitud del funcionario</strong><small>Presentación registrada</small></div><span class="badge">Completado</span></div><div><span class="step-mark">✓</span><div><strong>Responsable de departamento</strong><small>Primer nivel de aprobación</small></div><span class="badge">Aprobado</span></div><div><span class="step-mark pending">3</span><div><strong>Recursos Humanos</strong><small>Nivel habilitado para revisión</small></div><span class="badge pending">Pendiente</span></div></div><div class="demo-panel"><h4>Trazabilidad de la solicitud</h4><p>Etapas, responsables y resolución en un mismo recorrido.</p></div></>}
 </div></div></div><figcaption>Representación ilustrativa del producto · datos ficticios, sin información de clientes.</figcaption>
</figure>
